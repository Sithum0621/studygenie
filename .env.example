# Supabase — dashboard eken copy karanna.
# Keys always .env files / hosting env vars walin witharak. Code eke hardcode karanna epa.
# Local: me file eka copy කරලා .env.local hadanna.
# Production: same names hosting dashboard eke (Vercel Environment Variables).
# Service role / secret key danna epa.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI — server only. Browser eke expose karanne naha.
# Gemini (free): https://aistudio.google.com/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
